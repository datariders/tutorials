{
  "family": "bifrost-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/bifrostExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/bifrostTaskRole",
  "containerDefinitions": [
    {
      "name": "bifrost",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/bifrost-gateway:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "essential": true,
      "environment": [
        { "name": "AWS_REGION", "value": "<REGION>" }
      ],
      "secrets": [
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:bifrost/anthropic-api-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bifrost-gateway",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "bifrost"
        }
      }
    }
  ]
}
